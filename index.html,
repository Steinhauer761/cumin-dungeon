<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connex - Premium Network</title>
    <script src="https://tailwindcss.com"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-gray-900 text-gray-100 font-sans">

    <!-- Top Bar -->
    <header class="bg-gray-800 p-4 shadow-md sticky top-0 z-50 border-b border-gray-700">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-bold tracking-wider text-pink-500">CONNEX</h1>
            <div class="flex gap-2">
                <button onclick="openCreatorForm()" class="text-xs bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 rounded-full font-bold transition">
                    Join as Creator
                </button>
                <div id="user-balance" class="text-xs bg-gray-700 px-3 py-1.5 rounded-full text-yellow-400 font-semibold flex items-center">
                    3 Free Messages Left
                </div>
            </div>
        </div>
    </header>

    <!-- Navigation Filters -->
    <div class="max-w-4xl mx-auto mt-4 px-4 flex gap-2 overflow-x-auto pb-2">
        <button onclick="filterTags('all')" class="bg-pink-600 px-4 py-1 rounded-full text-xs font-bold">All</button>
        <button onclick="filterTags('#Webcam')" class="bg-gray-800 hover:bg-gray-700 px-4 py-1 rounded-full text-xs">#Webcam</button>
        <button onclick="filterTags('#Dates')" class="bg-gray-800 hover:bg-gray-700 px-4 py-1 rounded-full text-xs">#Dates</button>
        <button onclick="filterTags('#OnlyFans')" class="bg-gray-800 hover:bg-gray-700 px-4 py-1 rounded-full text-xs">#OnlyFans</button>
    </div>

    <!-- Main Feed -->
    <main id="directory-feed" class="max-w-4xl mx-auto p-4 space-y-4">
        <!-- Models injected by app.js -->
    </main>

    <!-- Creator Sign-Up Modal -->
    <div id="creator-modal" class="fixed inset-0 bg-black/80 hidden z-50 flex items-center justify-center p-4">
        <div class="bg-gray-800 w-full max-w-md rounded-xl p-6 border border-gray-700 shadow-2xl">
            <div class="flex justify-between items-center border-b border-gray-700 pb-3 mb-4">
                <h3 class="font-bold text-lg text-emerald-400">Creator Application</h3>
                <button onclick="closeCreatorForm()" class="text-gray-400 text-xl font-bold hover:text-white">&times;</button>
            </div>
            <form onsubmit="submitCreatorForm(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Stage Name</label>
                    <input id="form-name" type="text" required class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 mb-1">Age</label>
                        <input id="form-age" type="number" required class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-400 mb-1">Location</label>
                        <input id="form-location" type="text" required class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Availability Tags (e.g. #Webcam, #Dates)</label>
                    <input id="form-tags" type="text" placeholder="#Webcam, #OnlyFans" required class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-400 mb-1">Short Bio</label>
                    <textarea id="form-bio" rows="2" required class="w-full bg-gray-900 border border-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500"></textarea>
                </div>
                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded text-sm transition">
                    Submit via WhatsApp
                </button>
            </form>
        </div>
    </div>

    <!-- Chat Modal -->
    <div id="chat-modal" class="fixed inset-0 bg-black/80 hidden z-50 flex items-end justify-center">
        <div class="bg-gray-800 w-full max-w-md rounded-t-2xl p-4 flex flex-col h-[80vh]">
            <div class="flex justify-between items-center border-b border-gray-700 pb-2 mb-2">
                <h3 id="chat-header-title" class="font-bold text-lg text-pink-400">Chat</h3>
                <button onclick="closeChat()" class="text-gray-400 text-xl font-bold">&times;</button>
            </div>
            
            <div id="message-stream" class="flex-1 overflow-y-auto space-y-2 p-2 bg-gray-900 rounded-lg"></div>

            <!-- Paywall Lock Screen -->
            <div id="paywall-lock" class="hidden text-center p-4 bg-gray-900 border border-yellow-500 rounded-lg my-2">
                <p class="text-yellow-400 font-bold mb-1">Chat Limit Reached!</p>
                <p class="text-xs text-gray-400 mb-3">Unlock unlimited chats & premium profiles instantly.</p>
                <a id="paywall-link" href="#" target="_blank" class="block w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 rounded text-sm text-center transition">
                    Message via WhatsApp to Unlock ($5)
                </a>
            </div>

            <div id="chat-input-area" class="mt-2 flex gap-2">
                <input id="message-input" type="text" placeholder="Type a message..." class="flex-1 bg-gray-700 rounded px-3 py-2 text-sm text-white focus:outline-none">
                <button onclick="sendMessage()" class="bg-pink-600 hover:bg-pink-500 px-4 py-2 rounded text-sm font-bold">Send</button>
            </div>
        </div>
    </div>

    <script src="app.js"></script>
</body>
</html>
