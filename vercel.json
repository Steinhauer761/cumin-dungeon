{
  "version": 2,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/hall.html", "destination": "/public/hall.html" },
    { "source": "/hall", "destination": "/public/hall.html" },
    { "source": "/room.html", "destination": "/public/room.html" },
    { "source": "/room", "destination": "/public/room.html" },
    { "source": "/castle-lobby.html", "destination": "/public/castle-lobby.html" },
    { "source": "/castle-lobby", "destination": "/public/castle-lobby.html" },
    { "source": "/games/:path*", "destination": "/games/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" },
    { "source": "/css/:path*", "destination": "/public/css/:path*" },
    { "source": "/media/:path*", "destination": "/public/media/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
