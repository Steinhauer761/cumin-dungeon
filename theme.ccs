/* --- Overhaul the Cheap Buttons --- */
button, .btn, .spin-button, .deal-button {
    background: linear-gradient(135deg, #d4af37 0%, #aa7c11 100%) !important; /* Rich Gold Gradient */
    color: #000000 !important;
    font-weight: 800 !important;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: 1px solid #ffdf73 !important;
    border-radius: 8px !important; /* Slightly softer, premium rounded edges */
    box-shadow: 0 4px 15px rgba(170, 124, 17, 0.4) !important;
    text-shadow: none !important;
    transition: all 0.2s ease-in-out !important;
}

button:hover, .btn:hover {
    background: linear-gradient(135deg, #ffdf73 0%, #d4af37 100%) !important;
    box-shadow: 0 6px 20px rgba(212, 175, 55, 0.6) !important;
    transform: translateY(-1px);
}

/* --- Upgrade the Plain Info / Stat Boxes --- */
.balance-box, .bet-box, .win-box, .stat-container {
    background: rgba(20, 20, 20, 0.8) !important; /* Deep, sleek translucent black */
    border: 1px solid rgba(214, 173, 55, 0.3) !important; /* Subtle gold border frame */
    border-radius: 12px !important;
    box-shadow: inset 0 0 10px rgba(0,0,0,0.8) !important;
}

/* --- Fix the Boring Grid Text (like Keno) --- */
.keno-grid-cell, .grid-number {
    background: #111111 !important;
    border: 1px solid #222222 !important;
    color: #ffffff !important;
    font-family: 'Cinzel', 'Georgia', serif !important; /* Sleek cinematic font fallback */
}
.keno-grid-cell.selected {
    background: #d4af37 !important;
    color: #000000 !important;
    box-shadow: 0 0 12px #d4af37 !important;
  }

